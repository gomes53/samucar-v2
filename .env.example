NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local default password is "admin". Set explicit values for shared environments.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Production: Azure Storage is accessed through the App Service managed identity.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_TABLE_NAME=vehicles
AZURE_STORAGE_CONTAINER_NAME=vehicle-images

# Optional for local Azure Storage development only. Do not commit a value.
# AZURE_STORAGE_CONNECTION_STRING=
